{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Wiki: Preview",
      "type": "process",
      "command": "python",
      "args": ["-m", "mkdocs", "serve", "--dev-addr", "127.0.0.1:18080"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
